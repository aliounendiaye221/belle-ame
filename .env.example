# =================================================================
# « À CHACUN UNE BELLE ÂME » — VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# Note : Aucun secret de production ne doit être consigné dans ce fichier.
# Copiez ce fichier vers .env pour le développement local.
# =================================================================

# Environnement d'exécution (development, test, production)
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Marqueur Vercel Serverless (Automatique sur Vercel : VERCEL=1)
# VERCEL=1

# URLs applicatives (Locales ou Vercel Production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001
API_URL=http://localhost:4000

# Base de Données PostgreSQL
DATABASE_URL="postgresql://belleame_user:belleame_password_local@localhost:5432/belleame_db?schema=public"

# Cache & Queues Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Sécurité & Authentification JWT
# Générer des chaînes aléatoires 64 caractères : openssl rand -base64 48
JWT_ACCESS_SECRET="local-dev-jwt-access-secret-minimum-32-characters-long!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="local-dev-jwt-refresh-secret-minimum-32-characters-long!"
JWT_REFRESH_EXPIRATION="30d"

# Stockage d'Objets S3 / MinIO (Médias & Pièces KYC)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PUBLIC_MEDIA=belleame-public-photos
S3_BUCKET_PRIVATE_KYC=belleame-private-kyc-vault
S3_FORCE_PATH_STYLE=true

# Fournisseurs Externes - SMS & OTP (MOCK_TEST en local)
# Options : MOCK_TEST, TERMII, TWILIO, INFOBIP
SMS_PROVIDER=MOCK_TEST
TERMII_API_KEY=""
TERMII_SENDER_ID="BelleAme"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Fournisseur KYC d'Identité (MOCK_TEST en local)
# Options : MOCK_TEST, SMILE_ID, PREMBLY
KYC_PROVIDER=MOCK_TEST
SMILE_ID_PARTNER_ID=""
SMILE_ID_API_KEY=""
SMILE_ID_SID_SERVER=""

# Fournisseur de Paiement Mobile Money & Cartes (MOCK_TEST en local)
# Options : MOCK_TEST, CINETPAY, BIZAO, WAVE, STRIPE
PAYMENT_PROVIDER=MOCK_TEST
PAYMENT_WEBHOOK_SECRET="local-dev-webhook-signature-secret-key"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
WAVE_API_KEY=""
STRIPE_SECRET_KEY=""

# Notifications Push Mobiles (FCM)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Clé de chiffrement applicatif des messages au repos (AES-256-GCM : 32 bytes hex)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Feature Flags par défaut
FEATURE_FLAG_PREMIUM_ADVANCED_FILTERS=true
FEATURE_FLAG_AUDIO_VIDEO_CALLS=false
