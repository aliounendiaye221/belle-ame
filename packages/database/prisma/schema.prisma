datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// ---------------------------------------------------------
// 1. UTILISATEURS, SESSIONS & APPAREILS
// ---------------------------------------------------------

enum AccountStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  SUSPENDED
  BANNED
  DELETED
}

enum RoleType {
  USER
  CUSTOMER_SUPPORT
  MODERATOR
  LEAD_MODERATOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id                  String         @id @default(uuid())
  phoneNumber         String         @unique // Format E.164 (+237, +229, +225, etc.)
  phoneHash           String         @unique // Hash SHA-256 pour indexation rapide sans exposer le numéro en clair
  email               String?        @unique
  passwordHash        String?
  status              AccountStatus  @default(UNVERIFIED)
  isPhoneVerified     Boolean        @default(false)
  isEmailVerified     Boolean        @default(false)
  isIdentityVerified  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastActiveAt        DateTime       @default(now())

  // Relations
  roles               UserRole[]
  sessions            UserSession[]
  devices             Device[]
  profile             Profile?
  verificationRequests VerificationRequest[]
  sentLikes           Like[]         @relation("SentLikes")
  receivedLikes       Like[]         @relation("ReceivedLikes")
  profileViewsSent    ProfileView[]  @relation("ViewsSent")
  profileViewsReceived ProfileView[] @relation("ViewsReceived")
  matchesAsUser1      Match[]        @relation("MatchesUser1")
  matchesAsUser2      Match[]        @relation("MatchesUser2")
  conversations       ConversationMember[]
  sentMessages        Message[]
  blocksInitiated     Block[]        @relation("BlocksInitiated")
  blocksReceived      Block[]        @relation("BlocksReceived")
  reportsCreated      Report[]       @relation("ReportsCreated")
  reportsTargeted     Report[]       @relation("ReportsTargeted")
  subscriptions       Subscription[]
  payments            Payment[]
  boosts              Boost[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  consents            ConsentRecord[]
  exportRequests      DataExportRequest[]
  deletionRequest     AccountDeletionRequest?
  assignedCases       ModerationCase[] @relation("AssignedModerator")
  decisionsMade       VerificationDecision[] @relation("ModeratorDecisions")
  actionsTaken        ModerationAction[] @relation("ModeratorActions")
  auditLogs           AdminAuditLog[] @relation("AdminLogs")
  referralInvitesSent ReferralInvite[] @relation("ReferrerInvites")
  referralUsed        ReferralInvite?  @relation("ReferredUser")

  @@index([phoneNumber])
  @@index([phoneHash])
  @@index([status])
  @@index([lastActiveAt])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType @default(USER)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model UserSession {
  id                String   @id @default(uuid())
  userId            String
  refreshTokenHash  String   @unique
  userAgent         String?
  ipAddress         String?
  isRevoked         Boolean  @default(false)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Device {
  id                String   @id @default(uuid())
  userId            String
  deviceFingerprint String   // Hash matériel/navigateur
  fcmToken          String?  // Jeton Push Mobile FCM
  deviceModel       String?
  osVersion         String?
  lastIpAddress     String?
  isTrusted         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([deviceFingerprint])
}

// ---------------------------------------------------------
// 2. PROFILS, PRÉFÉRENCES, PHOTOS & INTÉRÊTS
// ---------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum FamilyStatus {
  SINGLE_NO_CHILDREN
  SINGLE_WITH_CHILDREN
  DIVORCED_NO_CHILDREN
  DIVORCED_WITH_CHILDREN
  WIDOWED
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Profile {
  id                String        @id @default(uuid())
  userId            String        @unique
  firstName         String
  birthDate         DateTime      // Contrôle 18+ strict
  calculatedAge     Int
  gender            Gender
  city              String
  country           String        // "CM", "BJ", "CI", "FR", etc.
  occupation        String?
  educationLevel    String?
  bio               String?       @db.Text
  relationshipGoal  String?       @db.Text
  personalValues    String[]      // Mots-clés de valeurs
  familyStatus      FamilyStatus?
  completionRate    Int           @default(0) // 0 à 100%
  isVerifiedBadge   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preference        Preference?
  photos            Photo[]
  interests         Interest[]

  @@index([userId])
  @@index([country, city])
  @@index([calculatedAge])
  @@index([gender])
}

model Preference {
  id                 String         @id @default(uuid())
  profileId          String         @unique
  targetGenders      Gender[]
  minAge             Int            @default(18)
  maxAge             Int            @default(60)
  targetCountries    String[]
  targetCities       String[]
  targetFamilyStatus FamilyStatus[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  profile            Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Interest {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String
  profiles  Profile[]

  @@index([category])
}

model Photo {
  id                String                @id @default(uuid())
  profileId         String
  url               String                // URL CDN optimisée WebP
  storageKey        String                // Clé privée S3 originale
  thumbnailUrl      String
  order             Int                   @default(0)
  isMain            Boolean               @default(false)
  moderationStatus  PhotoModerationStatus @default(PENDING)
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  profile           Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([moderationStatus])
}

// ---------------------------------------------------------
// 3. VÉRIFICATION D'IDENTITÉ (KYC) - SÉGRÉGATION STRICTE
// ---------------------------------------------------------

enum VerificationStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUPPLEMENTARY_INFO_REQUIRED
  SUSPENDED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  VOTER_CARD
  RESIDENCE_PERMIT
  SELFIE
}

model VerificationRequest {
  id                String             @id @default(uuid())
  userId            String
  status            VerificationStatus @default(PENDING)
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  rejectionReason   String?
  internalNotes     String?            @db.Text
  providerName      String             @default("MANUAL_OR_MOCK")
  providerTxId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         VerificationDocument[]
  decisions         VerificationDecision[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model VerificationDocument {
  id                    String              @id @default(uuid())
  verificationRequestId String
  documentType          DocumentType
  encryptedStorageKey   String              // Clé S3 dans bucket privé chiffré
  fileHash              String              // SHA-256 pour intégrité et détection de doublons
  mimeType              String
  fileSizeBytes         Int
  isPurged              Boolean             @default(false) // Purge d'image après 30 jours
  purgedAt              DateTime?
  createdAt             DateTime            @default(now())

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId])
  @@index([fileHash])
}

model VerificationDecision {
  id                    String              @id @default(uuid())
  verificationRequestId String
  moderatorId           String
  previousStatus        VerificationStatus
  newStatus             VerificationStatus
  decisionReason        String
  comment               String?             @db.Text
  createdAt             DateTime            @default(now())

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  moderator             User                @relation("ModeratorDecisions", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([verificationRequestId])
  @@index([moderatorId])
}

// ---------------------------------------------------------
// 4. DÉCOUVERTE, MATCHING & INTERACTIONS
// ---------------------------------------------------------

model ProfileView {
  id          String   @id @default(uuid())
  viewerId    String
  targetId    String
  createdAt   DateTime @default(now())

  viewer      User     @relation("ViewsSent", fields: [viewerId], references: [id], onDelete: Cascade)
  target      User     @relation("ViewsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([viewerId, targetId])
  @@index([viewerId])
  @@index([targetId])
}

model Like {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  isMutual    Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentLikes", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedLikes", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Match {
  id             String        @id @default(uuid())
  user1Id        String
  user2Id        String
  isActive       Boolean       @default(true)
  cancelledById  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user1          User          @relation("MatchesUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2          User          @relation("MatchesUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation   Conversation?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ---------------------------------------------------------
// 5. MESSAGERIE INSTANTANÉE (MUTUAL OPT-IN OBLIGATOIRE)
// ---------------------------------------------------------

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id              String               @id @default(uuid())
  matchId         String               @unique
  lastMessageAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  match           Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members         ConversationMember[]
  messages        Message[]

  @@index([matchId])
  @@index([lastMessageAt])
}

model ConversationMember {
  id              String       @id @default(uuid())
  conversationId  String
  userId          String
  joinedAt        DateTime     @default(now())
  lastReadAt      DateTime?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id              String              @id @default(uuid())
  conversationId  String
  senderId        String
  content         String              @db.Text // Chiffré au repos (AES-256 applicatif)
  status          MessageStatus       @default(SENT)
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments     MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageAttachment {
  id          String   @id @default(uuid())
  messageId   String
  fileUrl     String
  fileType    String
  fileSize    Int
  createdAt   DateTime @default(now())

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ---------------------------------------------------------
// 6. SÉCURITÉ, BLOCS, SIGNALEMENTS & MODÉRATION
// ---------------------------------------------------------

model Block {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  reason      String?
  createdAt   DateTime @default(now())

  blocker     User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum ReportCategory {
  INAPPROPRIATE_PROFILE
  OBSCENE_PHOTO
  HARASSMENT_MESSAGE
  FINANCIAL_SCAM_SOLICITATION // Broutage / Sollicitations monétaires
  IDENTITY_THEFT
  UNDERAGE_SUSPICION
  SUSPICIOUS_BEHAVIOR
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationStatus {
  OPEN
  ASSIGNED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id             String           @id @default(uuid())
  reporterId     String
  reportedUserId String
  category       ReportCategory
  priority       ReportPriority   @default(MEDIUM)
  description    String           @db.Text
  evidenceUrls   String[]
  status         ModerationStatus @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reporter       User             @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User             @relation("ReportsTargeted", fields: [reportedUserId], references: [id], onDelete: Cascade)
  moderationCase ModerationCase?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([category])
  @@index([status])
  @@index([priority])
}

model ModerationCase {
  id                String             @id @default(uuid())
  reportId          String             @unique
  assignedModId     String?
  slaDeadline       DateTime           // Moins de 24h après ouverture
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  report            Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assignedModerator User?              @relation("AssignedModerator", fields: [assignedModId], references: [id], onDelete: SetNull)
  actions           ModerationAction[]

  @@index([reportId])
  @@index([assignedModId])
  @@index([slaDeadline])
}

enum ModActionType {
  WARNING_SENT
  INFO_REQUESTED
  PHOTO_HIDDEN
  TEMP_RESTRICTION
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  RE_VERIFICATION_REQUIRED
  CASE_DISMISSED
  ESCALATED_TO_LEAD
}

model ModerationAction {
  id                String         @id @default(uuid())
  moderationCaseId  String
  moderatorId       String
  actionType        ModActionType
  internalRationale String         @db.Text
  userNotice        String?        @db.Text
  createdAt         DateTime       @default(now())

  moderationCase    ModerationCase @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderator         User           @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([moderationCaseId])
  @@index([moderatorId])
}

// ---------------------------------------------------------
// 7. MONÉTISATION, ABONNEMENTS & PAIEMENTS MOBILE MONEY
// ---------------------------------------------------------

enum PlanInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  description   String
  interval      PlanInterval
  priceInCents  Int            // En centimes (ex: 3 000 FCFA = 300000)
  currency      String         @default("XOF")
  features      String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]

  @@index([interval])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime
  autoRenew   Boolean            @default(false)
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([userId])
  @@index([status])
}

enum PaymentProviderType {
  MOCK_TEST
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Payment {
  id                  String              @id @default(uuid())
  userId              String
  subscriptionId      String?
  provider            PaymentProviderType
  providerTxId        String?             @unique
  amountInCents       Int
  currency            String              @default("XOF")
  status              PaymentStatus       @default(PENDING)
  receiptUrl          String?
  errorMessage        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  webhookEvents       PaymentWebhookEvent[]

  @@index([userId])
  @@index([status])
  @@index([providerTxId])
}

model PaymentWebhookEvent {
  id              String              @id @default(uuid())
  paymentId       String?
  provider        PaymentProviderType
  externalEventId String              @unique // Clé d'idempotence
  payload         Json
  isProcessed     Boolean             @default(false)
  processedAt     DateTime?
  createdAt       DateTime            @default(now())

  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([externalEventId])
  @@index([isProcessed])
}

model Boost {
  id          String   @id @default(uuid())
  userId      String
  durationMin Int      @default(60)
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------
// 8. NOTIFICATIONS & PRÉFÉRENCES
// ---------------------------------------------------------

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum NotificationType {
  OTP_CODE
  KYC_APPROVED
  KYC_REJECTED
  NEW_MATCH
  NEW_MESSAGE
  PHOTO_MODERATED
  REPORT_UPDATE
  SUBSCRIPTION_CONFIRMED
  SUBSCRIPTION_EXPIRED
}

model Notification {
  id          String              @id @default(uuid())
  userId      String
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String              @db.Text
  metadata    Json?
  isRead      Boolean             @default(false)
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  allowPushMatch   Boolean  @default(true)
  allowPushMessage Boolean  @default(true)
  allowEmailDigest Boolean  @default(false)
  allowSmsSecurity Boolean  @default(true) // Non désactivable
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------
// 9. MIGRATION WHATSAPP & AUDIT TRAIL
// ---------------------------------------------------------

model ReferralInvite {
  id                String    @id @default(uuid())
  code              String    @unique // Ex: "WA9000-DOUALA-01"
  campaignName      String    // Ex: "whatsapp-community-wave-1"
  referrerId        String?
  referredUserId    String?   @unique
  maxUses           Int       @default(1)
  currentUses       Int       @default(0)
  promoDurationDays Int       @default(30) // 1 mois Premium offert
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  referrer          User?     @relation("ReferrerInvites", fields: [referrerId], references: [id], onDelete: SetNull)
  referredUser      User?     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([campaignName])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String   // "VIEW_KYC_DOC", "BAN_USER", "REFUND_PAYMENT"
  entityType  String
  entityId    String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin       User     @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  isEnabled   Boolean  @default(false)
  targetRoles RoleType[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ---------------------------------------------------------
// 10. CONFORMITÉ, PROTECTION DES DONNÉES & DROIT À L'OUBLI
// ---------------------------------------------------------

model ConsentRecord {
  id           String   @id @default(uuid())
  userId       String
  consentType  String   // "TERMS_OF_SERVICE", "PRIVACY_POLICY"
  version      String   // "v1.0"
  hasConsented Boolean  @default(true)
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType, version])
}

enum RequestProcessStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model DataExportRequest {
  id          String               @id @default(uuid())
  userId      String
  status      RequestProcessStatus @default(PENDING)
  downloadUrl String?              // URL signée temporaire (24h)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountDeletionRequest {
  id               String               @id @default(uuid())
  userId           String               @unique
  reason           String?
  status           RequestProcessStatus @default(PENDING)
  gracePeriodEndAt DateTime             // Délai de grâce de 14 jours
  cancelledAt      DateTime?
  executedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gracePeriodEndAt])
}
